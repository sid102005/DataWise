# ==============================================================================
# DataWise Configuration Template (.env.example)
# Copy this file to .env and customize for local development.
# NOTE: .env must remain local and must never be committed to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# API & Network Configuration
# ------------------------------------------------------------------------------
# URL used by the Streamlit frontend to connect to the FastAPI backend
DATAWISE_API_URL=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# Multimedia Tooling Overrides (Optional)
# ------------------------------------------------------------------------------
# By default, DataWise automatically discovers FFmpeg and FFprobe on PATH or
# well-known Windows WinGet installation paths. Specify explicit paths if needed:
# FFMPEG_BINARY=C:\path\to\ffmpeg.exe
# FFPROBE_BINARY=C:\path\to\ffprobe.exe
# Optional OCR override if tesseract.exe is not on PATH:
# TESSERACT_BINARY=C:\Program Files\Tesseract-OCR\tesseract.exe

# ------------------------------------------------------------------------------
# External AI / LLM API Keys (Optional)
# ------------------------------------------------------------------------------
# By default, DataWise runs 100% offline using a deterministic heuristic pipeline.
# If cloud LLM or multimodal vision extensions are configured in future phases:
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
