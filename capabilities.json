{
  "processors": {
    "tabular": {
      "supported": true,
      "planned_in_phase": null
    },
    "document": {
      "supported": true,
      "planned_in_phase": 10,
      "operations": [
        "extract_text",
        "extract_text_ocr",
        "clean_text",
        "count_words",
        "extract_metadata",
        "extract_headings",
        "extract_tables",
        "split_pages",
        "extract_entities",
        "extract_key_values",
        "find_mentions",
        "extract_links",
        "detect_language",
        "extract_images",
        "redact_pii",
        "extractive_summary",
        "llm_analysis",
        "convert_format"
      ],
      "formats": ["pdf", "docx", "txt", "md"],
      "limitations": {
        "ocr": "Supported when Tesseract binary + pytesseract are installed; auto-used for scanned PDFs with no text layer",
        "llm_qa": "Optional — requires ANTHROPIC_API_KEY or GEMINI_API_KEY; falls back to raw text",
        "legacy_doc": "Detected but rejected (binary/macros not supported)",
        "pptx": "Presentation processor planned separately"
      }
    },
    "image": {
      "supported": true,
      "planned_in_phase": 11,
      "operations": [
        "resize",
        "crop",
        "rotate",
        "convert_format",
        "compress",
        "extract_metadata",
        "extract_text_ocr"
      ],
      "limitations": {
        "ocr": "Supported when Tesseract binary + pytesseract are installed",
        "description_classification": "Deferred to future phase - requires vision LLM API key",
        "background_removal": "Not supported",
        "batch_processing": "Supported across all file categories in Phase 13"
      }
    },
    "audio": {
      "supported": true,
      "planned_in_phase": 12,
      "operations": [
        "extract_metadata",
        "trim",
        "convert_format",
        "compress"
      ],
      "limitations": {
        "transcription": "Deferred to future phase - requires speech model"
      }
    },
    "video": {
      "supported": true,
      "planned_in_phase": 12,
      "operations": [
        "extract_metadata",
        "trim",
        "extract_frame",
        "resize",
        "convert_format",
        "compress",
        "extract_audio"
      ],
      "limitations": {
        "complex_effects": "Transitions, filters, and AI tracking deferred to future phase"
      }
    },
    "archive": {
      "supported": true,
      "planned_in_phase": 13,
      "operations": [
