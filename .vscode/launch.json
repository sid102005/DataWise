{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "DataWise: Backend (FastAPI)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "backend.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--workers",
        "1"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "DataWise: Frontend (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "frontend/app.py",
        "--server.port",
        "8501",
        "--server.headless",
        "true"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "DataWise: Backend only (module)",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.main",
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ],
  "compounds": [
    {
      "name": "DataWise: Full Stack",
      "configurations": [
        "DataWise: Backend (FastAPI)",
        "DataWise: Frontend (Streamlit)"
      ],
      "stopAll": true,
      "presentation": {
        "group": "datawise",
        "order": 1
      }
    }
  ]
}
